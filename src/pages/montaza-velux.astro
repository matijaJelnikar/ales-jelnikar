---
import Layout from '../layouts/Layout.astro';
import Reviews from '../components/Reviews.astro';
import Contact from '../components/Contact.astro';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Domov", "item": "https://alesjelnikar.si/" },
        { "@type": "ListItem", "position": 2, "name": "Montaža VELUX strešnih oken", "item": "https://alesjelnikar.si/montaza-velux" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Kako dolgo traja montaža VELUX okna?",
          "acceptedAnswer": { "@type": "Answer", "text": "Montaža enega VELUX okna traja od 2 do 4 ure, odvisno od tipa okna in stanja strehe." }
        },
        {
          "@type": "Question",
          "name": "Ali montirate vsa VELUX okna?",
          "acceptedAnswer": { "@type": "Answer", "text": "Da, montiramo vse tipe VELUX strešnih oken — klasična, panoramska in svetlobnike. Ročno ali električno upravljanje." }
        },
        {
          "@type": "Question",
          "name": "Kaj je vključeno v ceno montaže?",
          "acceptedAnswer": { "@type": "Answer", "text": "Cena montaže vključuje vgradnjo okna z originalnimi VELUX obrobami za 100-odstotno vodotesnost. Za natančen predračun pošljite povpraševanje." }
        },
        {
          "@type": "Question",
          "name": "Kje v Sloveniji izvajate montažo VELUX oken?",
          "acceptedAnswer": { "@type": "Answer", "text": "Montažo VELUX oken izvajamo v osrednji Sloveniji: Ljubljana in okolica, Domžale, Kamnik, Grosuplje, Litija in Medvode." }
        }
      ]
    }
  ]
});
---

<Layout
  title="Montaža VELUX strešnih oken – Aleš Jelnikar | Ljubljana in osrednja Slovenija"
  description="Montaža Velux strešnih oken v Ljubljani in osrednji Sloveniji. Klasična, panoramska okna in svetlobniki. Priporočen VELUX izvajalec z 15+ leti izkušenj."
  schema={schema}
>
  <!-- Hero section -->
  <section class="bg-surface-container-low py-20">
    <div class="container mx-auto px-6 max-w-4xl">
      <a href="/" class="flex w-fit items-center gap-1 text-secondary hover:text-primary transition-colors mb-10 text-sm font-medium">
        <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_back</span>
        Nazaj na domačo stran
      </a>
      <span class="inline-block bg-primary text-on-primary text-xs font-bold px-3 py-1 mb-6 tracking-widest uppercase">
        Priporočen VELUX Izvajalec
      </span>
      <h1 class="font-headline text-4xl md:text-6xl font-extrabold text-on-surface leading-tight mb-6 tracking-tight">
        Montaža VELUX strešnih oken
      </h1>
      <p class="text-xl text-secondary leading-relaxed max-w-2xl mb-8">
        Aleš Jelnikar izvaja montažo strešnih oken VELUX v Ljubljani in osrednji Sloveniji. Montaža vseh tipov — klasičnih, panoramskih in svetlobnikov. Ročno ali električno upravljanje, 100-odstotna vodotesnost z originalnimi VELUX obrobami.
      </p>
      <a
        href="/povprasevanje?tab=montaza"
        class="bg-primary text-on-primary px-8 py-4 font-bold inline-flex items-center gap-2 hover:shadow-lg transition-all active:scale-95"
      >
        Naročite montažo
        <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
      </a>
    </div>
  </section>

  <!-- Service detail -->
  <section class="py-20 bg-surface">
    <div class="container mx-auto px-6 max-w-4xl">

      <h2 class="font-headline text-2xl md:text-3xl font-extrabold mb-2">Tipi VELUX oken za montažo</h2>
      <div class="h-1 w-16 bg-primary mb-8"></div>

      <div class="grid md:grid-cols-3 gap-6 mb-16">
        <div class="bg-surface-container-lowest p-8 border border-outline-variant/10">
          <span class="material-symbols-outlined text-primary text-3xl mb-4" aria-hidden="true">window</span>
          <h3 class="font-bold font-headline mb-2">Klasična strešna okna</h3>
          <p class="text-sm text-secondary leading-relaxed">Standardna VELUX strešna okna za mansarde in podstrešja. Ročno ali električno odpiranje.</p>
        </div>
        <div class="bg-surface-container-lowest p-8 border border-outline-variant/10">
          <span class="material-symbols-outlined text-primary text-3xl mb-4" aria-hidden="true">panorama</span>
          <h3 class="font-bold font-headline mb-2">Panoramska okna</h3>
          <p class="text-sm text-secondary leading-relaxed">Večja zasteklitev za maksimalen vnos dnevne svetlobe in razgled.</p>
        </div>
        <div class="bg-surface-container-lowest p-8 border border-outline-variant/10">
          <span class="material-symbols-outlined text-primary text-3xl mb-4" aria-hidden="true">wb_sunny</span>
          <h3 class="font-bold font-headline mb-2">Svetlobniki</h3>
          <p class="text-sm text-secondary leading-relaxed">Idealna rešitev za hodnike in kopalnice brez neposrednega dostopa do svetlobe.</p>
        </div>
      </div>

      <h2 class="font-headline text-2xl md:text-3xl font-extrabold mb-2">Elektrificiranje strešnih oken</h2>
      <div class="h-1 w-16 bg-primary mb-6"></div>
      <p class="text-secondary leading-relaxed mb-12 max-w-2xl">
        Elektrificiranje že obstoječih ali novih strešnih oken VELUX. Možnost namestitve dežnega senzorja za samodejno zapiranje ob dežju — praktično in energetsko varčno.
      </p>

      <h2 class="font-headline text-2xl md:text-3xl font-extrabold mb-2">Obrobe in senčila</h2>
      <div class="h-1 w-16 bg-primary mb-6"></div>
      <p class="text-secondary leading-relaxed mb-8 max-w-2xl">
        Zagotavljamo vodotesnost z originalnimi VELUX obrobami. Montaža notranjih in zunanjih senčil po meri za popoln nadzor svetlobe in zasebnosti.
      </p>

      <h2 class="font-headline text-2xl md:text-3xl font-extrabold mb-2">Postopek montaže</h2>
      <div class="h-1 w-16 bg-primary mb-6"></div>
      <ol class="text-secondary text-sm space-y-3 leading-relaxed mb-12 max-w-2xl list-none">
        <li class="flex gap-3"><span class="bg-primary text-on-primary font-bold text-xs w-6 h-6 rounded-full flex items-center justify-center shrink-0 mt-0.5">1</span>Ogled in svetovanje — ocenimo stanje, priporočimo tip okna</li>
        <li class="flex gap-3"><span class="bg-primary text-on-primary font-bold text-xs w-6 h-6 rounded-full flex items-center justify-center shrink-0 mt-0.5">2</span>Neobvezujoč predračun</li>
        <li class="flex gap-3"><span class="bg-primary text-on-primary font-bold text-xs w-6 h-6 rounded-full flex items-center justify-center shrink-0 mt-0.5">3</span>Montaža z originalnimi VELUX obrobami</li>
        <li class="flex gap-3"><span class="bg-primary text-on-primary font-bold text-xs w-6 h-6 rounded-full flex items-center justify-center shrink-0 mt-0.5">4</span>Pregled vodotesnosti in nastavitev</li>
      </ol>

      <a
        href="/povprasevanje?tab=montaza"
        class="bg-primary text-on-primary px-8 py-4 font-bold inline-flex items-center gap-2 hover:shadow-lg transition-all active:scale-95 mb-16"
      >
        Pošlji povpraševanje
        <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
      </a>

      <h2 class="font-headline text-2xl md:text-3xl font-extrabold mb-2">Območje montaže</h2>
      <div class="h-1 w-16 bg-primary mb-6"></div>
      <p class="text-secondary leading-relaxed max-w-2xl">
        Montažo VELUX strešnih oken izvajamo v osrednji Sloveniji: <strong>Ljubljana</strong> in okolica, <strong>Domžale</strong>, <strong>Kamnik</strong>, <strong>Grosuplje</strong>, <strong>Litija</strong>, <strong>Medvode</strong> in bližnja okolica.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-surface-container-low">
    <div class="container mx-auto px-6 max-w-4xl">
      <h2 class="font-headline text-2xl md:text-3xl font-extrabold mb-2">Pogosta vprašanja o montaži VELUX</h2>
      <div class="h-1 w-16 bg-primary mb-8"></div>
      <div class="space-y-6">
        <div class="bg-surface-container-lowest p-6 border border-outline-variant/10">
          <h3 class="font-bold mb-2">Kako dolgo traja montaža VELUX okna?</h3>
          <p class="text-secondary text-sm leading-relaxed">Montaža enega VELUX okna traja od 2 do 4 ure, odvisno od tipa okna in stanja strehe.</p>
        </div>
        <div class="bg-surface-container-lowest p-6 border border-outline-variant/10">
          <h3 class="font-bold mb-2">Ali montirate vsa VELUX okna?</h3>
          <p class="text-secondary text-sm leading-relaxed">Da, montiramo vse tipe VELUX strešnih oken — klasična, panoramska in svetlobnike. Ročno ali električno upravljanje.</p>
        </div>
        <div class="bg-surface-container-lowest p-6 border border-outline-variant/10">
          <h3 class="font-bold mb-2">Kaj je vključeno v ceno montaže?</h3>
          <p class="text-secondary text-sm leading-relaxed">Cena montaže vključuje vgradnjo okna z originalnimi VELUX obrobami za 100-odstotno vodotesnost. Za natančen predračun pošljite povpraševanje.</p>
        </div>
        <div class="bg-surface-container-lowest p-6 border border-outline-variant/10">
          <h3 class="font-bold mb-2">Kje v Sloveniji izvajate montažo VELUX oken?</h3>
          <p class="text-secondary text-sm leading-relaxed">Montažo VELUX oken izvajamo v osrednji Sloveniji: Ljubljana in okolica, Domžale, Kamnik, Grosuplje, Litija in Medvode.</p>
        </div>
      </div>
    </div>
  </section>

  <Reviews />
  <Contact />
</Layout>

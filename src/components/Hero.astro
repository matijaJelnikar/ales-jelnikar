---

---

<section class="relative min-h-[751px] flex items-center overflow-hidden bg-surface">
  <div class="absolute inset-0 z-0">
    <img
      alt="Moderna mansarda z več velikimi strešnimi okni VELUX, ki prepuščajo naravno dnevno svetlobo"
      class="w-full h-full object-cover opacity-90"
      src="/hero.jpg"
      width="1920"
      height="1080"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-linear-to-r from-surface via-surface/60 to-transparent"></div>
  </div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-2xl">
      <span
        class="inline-block bg-primary text-on-primary text-xs font-bold px-3 py-1 mb-6 tracking-widest uppercase"
      >
        Priporočen VELUX Izvajalec
      </span>
      <h1
        class="font-headline text-5xl md:text-7xl font-extrabold text-on-surface leading-[1.1] mb-6 tracking-tight"
      >
        Svetloba v <span class="text-primary italic">vaš dom</span>
      </h1>
      <p class="text-xl text-secondary mb-10 leading-relaxed max-w-lg">
        Strokoven servis in montaža strešnih oken VELUX. Z večletnimi izkušnjami
        zagotavljamo vrhunsko kakovost bivanja pod vašo streho.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href="tel:031556508"
          class="bg-primary text-on-primary px-8 py-4 font-bold flex items-center justify-center gap-2 hover:shadow-lg transition-all active:scale-95"
        >
          <span class="material-symbols-outlined" aria-hidden="true">call</span>
          Pokličite nas
        </a>
        <a
          href="/povprasevanje"
          class="bg-surface-container-highest text-on-secondary-container px-8 py-4 font-bold flex items-center justify-center gap-2 hover:bg-surface-container-high transition-all active:scale-95"
        >
          Pošljite povpraševanje
        </a>
      </div>
    </div>
  </div>
</section>

<section id="storitve" class="py-24 md:py-32 px-6 md:px-24 bg-surface-container-low">
  <div class="max-w-7xl mx-auto">
    <div class="mb-16 md:mb-20 space-y-4">
      <span class="font-label text-secondary font-bold uppercase tracking-widest text-sm">Naše Storitve</span>
      <h2 class="font-headline text-4xl md:text-5xl font-bold text-primary">Profesionalne Rešitve</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-12">
      <div class="space-y-6">
        <div class="w-16 h-16 bg-primary-container rounded-xl flex items-center justify-center">
          <span class="material-symbols-outlined text-on-primary-container text-3xl">window</span>
        </div>
        <h3 class="font-headline text-2xl font-bold text-primary">Vgradnja oken</h3>
        <p class="font-body text-on-surface-variant leading-relaxed">
          Strokovna montaža novih VELUX strešnih oken po najvišjih standardih proizvajalca za popolno tesnjenje in dolgoletno brezhibnost.
        </p>
      </div>
      <div class="space-y-6">
        <div class="w-16 h-16 bg-secondary-container rounded-xl flex items-center justify-center">
          <span class="material-symbols-outlined text-on-secondary-container text-3xl">build</span>
        </div>
        <h3 class="font-headline text-2xl font-bold text-primary">Servis in vzdrževanje</h3>
        <p class="font-body text-on-surface-variant leading-relaxed">
          Redni pregledi, menjava tesnil, mazanje okovja in popravila za dolgotrajno brezhibno delovanje vaših strešnih oken.
        </p>
      </div>
      <div class="space-y-6">
        <div class="w-16 h-16 bg-primary-container rounded-xl flex items-center justify-center">
          <span class="material-symbols-outlined text-on-primary-container text-3xl">blinds</span>
        </div>
        <h3 class="font-headline text-2xl font-bold text-primary">Senčila in rolete</h3>
        <p class="font-body text-on-surface-variant leading-relaxed">
          Montaža notranjih in zunanjih senčil za optimalno toplotno izolacijo in popoln nadzor nad dnevno svetlobo.
        </p>
      </div>
    </div>
  </div>
</section>

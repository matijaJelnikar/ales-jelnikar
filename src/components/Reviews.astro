---
interface Review {
  _id: string;
  text: string;
  author: string;
  location: string;
}

const { reviews: sanityReviews = [] } = Astro.props as { reviews: Review[] };

const fallback: Review[] = [
  {
    _id: 'f1',
    text: 'Gospod Aleš je delo opravil izjemno profesionalno. Okna so bila vgrajena hitro, čisto in točno po dogovoru.',
    author: 'Marko P.',
    location: 'Ljubljana',
  },
  {
    _id: 'f2',
    text: 'Svetovanje pred nakupom je bilo ključno. Svetlobnik v hodniku je popolnoma spremenil vzdušje v hiši.',
    author: 'Ana L.',
    location: 'Domžale',
  },
  {
    _id: 'f3',
    text: 'Zelo odziven in strokoven. Njegove izkušnje se vidijo pri vsakem detajlu montaže.',
    author: 'Robert K.',
    location: 'Kranj',
  },
];

const reviews = sanityReviews.length > 0 ? sanityReviews : fallback;
---

<section class="py-24 bg-surface">
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="font-headline text-3xl md:text-4xl font-extrabold text-on-surface">Zadovoljne stranke</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {reviews.map((review) => (
        <div class="bg-surface-container-lowest p-8 border border-outline-variant/10 shadow-sm">
          <div
            class="flex text-primary mb-4"
            role="img"
            aria-label="Ocena: 5 od 5 zvezdic"
          >
            {Array(5).fill(null).map(() => (
              <span
                class="material-symbols-outlined"
                aria-hidden="true"
                style="font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;"
              >star</span>
            ))}
          </div>
          <blockquote class="text-on-surface mb-6 italic leading-relaxed">
            "{review.text}"
          </blockquote>
          <p class="font-bold text-sm">— {review.author}, {review.location}</p>
        </div>
      ))}
    </div>
  </div>
</section>

---
interface Review {
  _id: string;
  text: string;
  author: string;
  location: string;
}

const { reviews: sanityReviews = [] } = Astro.props as { reviews: Review[] };

const fallback: Review[] = [
  {
    _id: 'f1',
    text: 'Zelo zadovoljni z vgradnjo dveh novih oken. Aleš je bil točen, hiter in je za seboj vse pospravil. Svetloba v mansardi je zdaj neverjetna.',
    author: 'Marko P.',
    location: 'Ljubljana',
  },
  {
    _id: 'f2',
    text: 'Odličen servis starih oken. Zdaj spet tesnijo kot nova. Priporočam vsakomur, ki želi profesionalno opravljeno delo.',
    author: 'Ana L.',
    location: 'Kranj',
  },
  {
    _id: 'f3',
    text: 'Rolete na sončni pogon so bile najboljša investicija. Aleš nam je svetoval pri izbiri in montaža je bila brezhibna.',
    author: 'Janez K.',
    location: 'Celje',
  },
];

const reviews = sanityReviews.length > 0 ? sanityReviews : fallback;
---

<section id="ocene" class="py-24 md:py-32 px-6 md:px-24 bg-surface-container-low">
  <div class="max-w-7xl mx-auto">
    <h2 class="font-headline text-4xl font-bold text-center mb-16 md:mb-20 text-primary tracking-tight">
      Mnenja naših strank
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {reviews.map((review) => (
        <div class="bg-surface p-8 md:p-10 rounded-xl shadow-[0_20px_40px_rgba(43,44,42,0.06)] space-y-6">
          <div
            class="flex gap-0.5 text-secondary"
            role="img"
            aria-label="Ocena: 5 od 5 zvezdic"
          >
            {Array(5).fill(null).map(() => (
              <span
                class="material-symbols-outlined text-xl"
                aria-hidden="true"
                style="font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;"
              >star</span>
            ))}
          </div>
          <blockquote class="font-body italic text-on-surface-variant leading-relaxed">
            "{review.text}"
          </blockquote>
          <div class="pt-4 border-t border-outline-variant/30">
            <p class="font-headline font-bold text-primary">{review.author}</p>
            <p class="text-xs text-on-surface-variant uppercase tracking-widest">{review.location}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

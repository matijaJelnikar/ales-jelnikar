  },
  {
    _id: 'ph3',
    title: 'Kuhinja s strešnimi okni',
    afterUrl: 'https://lh3.googleusercontent.com/aida-public/AB6AXuB4wKQuSGLBR3bBTf5vgCGLnf6vpTXP9Svjyyq-jzPiOg97OAFT01gFFPuk0p2uB5iJVjn5-ZoTfZZbyS7LdBILu2xGWwHVcgywKYa1ujYgnQfBVZQHdSaq192DyWaVlJa-Iho9Aj1tVRNYpOG3YkxAlDMaBcAYdMvY0p7O70wSxH_uO0lNAxGTZV3x4uKR-40yvMPTw0lWu-mR7zp4SfQM2B6eH2e42vEmExjkHCL94qr4WHlUP5e1hEqwEMDYZoXQNmLZXiWAc1Qa',

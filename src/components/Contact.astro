---

---

<section id="kontakt" class="py-24 bg-surface-container-low overflow-hidden">
  <div class="container mx-auto px-6">
    <div class="flex flex-col lg:flex-row gap-16">

      <!-- Left: contact info -->
      <div class="lg:w-1/3">
        <h2 class="font-headline text-3xl md:text-4xl font-extrabold mb-8 text-on-surface">Kontaktirajte nas</h2>
        <p class="text-secondary mb-12">
          Pripravljeni smo odgovoriti na vsa vaša vprašanja in pripraviti neobvezujočo ponudbo.
        </p>

        <div class="space-y-8">
          <div class="flex items-start gap-4">
            <span class="material-symbols-outlined text-primary" aria-hidden="true">phone_in_talk</span>
            <div>
              <p class="font-bold text-sm uppercase tracking-wider text-secondary">Telefon</p>
              <a
                href="tel:031556508"
                class="text-lg font-headline font-bold hover:text-primary transition-colors"
              >031-556-508</a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <span class="material-symbols-outlined text-primary" aria-hidden="true">mail</span>
            <div>
              <p class="font-bold text-sm uppercase tracking-wider text-secondary">E-pošta</p>
              <a
                href="mailto:info@alesjelnikar.si"
                class="text-lg font-headline font-bold hover:text-primary transition-colors"
              >info@alesjelnikar.si</a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <span class="material-symbols-outlined text-primary" aria-hidden="true">location_on</span>
            <div>
              <p class="font-bold text-sm uppercase tracking-wider text-secondary">Lokacija</p>
              <p class="text-lg font-headline font-bold">Ljubljana &amp; okolica, Slovenija</p>
            </div>
          </div>
        </div>

        <!-- Map placeholder -->
        <div class="mt-12 w-full h-48 bg-surface-container grayscale opacity-80 overflow-hidden border border-outline-variant/30">
          <img
            class="w-full h-full object-cover"
            alt="Zemljevid osrednje Slovenije"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuAf3hkBNuJsA_uQE40BNJbdRzQqxlzvuJjmA0oM-9WBTmmdgMztOJ9-wiatjzW-GerCwoTjOCytQm_YzEGBiwavv9zUUVsszgTtzWZ3peFDUQl-krrWPAMII1KFuo3-DkFaE4MRe4qfVmbLt7WgIn-bKW7fqfQQWZliOeVeifSHhj_-oYKetdYkwM8I3cLSPUnZxrhPUhIlKPtsgSId8Yw7c3y7jyxd21E1GdJyLAmyqQLwJAQT79jpqqK3hRAQU6hBdf75zqnGViWt"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Right: contact form -->
      <div class="lg:w-2/3 bg-white p-8 md:p-12 shadow-2xl">
        <form id="contact-form" class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label for="ime" class="text-xs font-bold uppercase tracking-widest text-secondary">
              Ime in priimek <span aria-label="obvezno">*</span>
            </label>
            <input
              id="ime"
              name="ime"
              type="text"
              required
              maxlength="100"
              placeholder="Vpišite vaše ime"
              class="w-full bg-surface-container border-none focus:outline-none focus:ring-2 focus:ring-primary py-4 px-4 text-on-surface placeholder:text-secondary/50"
            />
          </div>

          <div class="space-y-2">
            <label for="telefon" class="text-xs font-bold uppercase tracking-widest text-secondary">
              Telefon
            </label>
            <input
              id="telefon"
              name="telefon"
              type="tel"
              maxlength="20"
              placeholder="041 000 000"
              class="w-full bg-surface-container border-none focus:outline-none focus:ring-2 focus:ring-primary py-4 px-4 text-on-surface placeholder:text-secondary/50"
            />
          </div>

          <div class="space-y-2 md:col-span-2">
            <label for="email" class="text-xs font-bold uppercase tracking-widest text-secondary">
              E-naslov <span aria-label="obvezno">*</span>
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              maxlength="200"
              placeholder="vas@email.com"
              class="w-full bg-surface-container border-none focus:outline-none focus:ring-2 focus:ring-primary py-4 px-4 text-on-surface placeholder:text-secondary/50"
            />
          </div>

          <div class="space-y-2">
            <label for="datum" class="text-xs font-bold uppercase tracking-widest text-secondary">
              Željeni datum
            </label>
            <input
              id="datum"
              name="datum"
              type="date"
              class="w-full bg-surface-container border-none focus:outline-none focus:ring-2 focus:ring-primary py-4 px-4 text-on-surface"
            />
          </div>

          <div class="space-y-2 md:col-span-2">
            <label for="opis" class="text-xs font-bold uppercase tracking-widest text-secondary">
              Opis dela <span aria-label="obvezno">*</span>
            </label>
            <textarea
              id="opis"
              name="opis"
              required
              rows="4"
              maxlength="2000"
              placeholder="Opišite vaše želje ali težave z okni..."
              class="w-full bg-surface-container border-none focus:outline-none focus:ring-2 focus:ring-primary py-4 px-4 text-on-surface placeholder:text-secondary/50 resize-none"
            ></textarea>
          </div>

          <!-- Honeypot — hidden from real users, catches bots -->
          <input
            type="text"
            name="website"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            class="hidden"
          />

          <!-- Status message -->
          <div
            id="form-status"
            role="alert"
            aria-live="polite"
            class="hidden text-sm font-body px-4 py-3 md:col-span-2"
          ></div>

          <div class="md:col-span-2 pt-4">
            <button
              type="submit"
              id="submit-btn"
              class="w-full bg-primary text-on-primary font-bold py-5 hover:opacity-90 active:scale-[0.98] transition-all uppercase tracking-widest"
            >
              Pošljite povpraševanje
            </button>
          </div>
        </form>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const statusEl = document.getElementById("form-status") as HTMLDivElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = "Pošiljanje...";

    const data = Object.fromEntries(new FormData(form));

    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 10000);

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
        signal: controller.signal,
      });
      clearTimeout(timeout);
      const json = await res.json();

      statusEl.classList.remove(
        "hidden",
        "bg-error-container",
        "text-on-error-container",
        "bg-primary-fixed",
        "text-on-primary-fixed",
      );

      if (res.ok) {
        statusEl.classList.add("bg-primary-fixed", "text-on-primary-fixed");
        statusEl.textContent =
          json.message ?? "Sporočilo je bilo uspešno poslano!";
        form.reset();
      } else {
        statusEl.classList.add("bg-error-container", "text-on-error-container");
        statusEl.textContent =
          json.message ?? "Prišlo je do napake. Prosimo, poskusite znova.";
      }
    } catch (err) {
      clearTimeout(timeout);
      statusEl.classList.remove("hidden", "bg-error-container");
      statusEl.classList.add("bg-error-container", "text-on-error-container");
      statusEl.textContent =
        err instanceof Error && err.name === "AbortError"
          ? "Zahtevek je trajal predolgo. Prosimo, poskusite znova."
          : "Napaka pri pošiljanju. Preverite internetno povezavo.";
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Pošljite povpraševanje";
      statusEl.classList.remove("hidden");
      statusEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }
  });
</script>

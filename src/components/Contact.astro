---

---

<section
  id="kontakt"
  class="py-24 md:py-32 px-6 md:px-24 bg-surface-container-lowest"
>
  <div
    class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24"
  >
    <!-- Contact info -->
    <div class="space-y-10">
      <div class="space-y-4">
        <span
          class="font-label text-secondary font-bold uppercase tracking-widest text-sm"
          >Kontakt</span
        >
        <h2 class="font-headline text-4xl md:text-5xl font-bold text-primary">
          Stopite v stik
        </h2>
        <p class="font-body text-on-surface-variant max-w-md">
          Izpolnite obrazec ali nas pokličite za brezplačen ogled in svetovanje
          na vašem domu.
        </p>
      </div>

      <div class="space-y-6">
        <div class="flex items-center gap-6">
          <div
            class="w-12 h-12 bg-surface-container-high rounded-full flex items-center justify-center text-primary flex-shrink-0"
            aria-hidden="true"
          >
            <span class="material-symbols-outlined" aria-hidden="true">call</span>
          </div>
          <div>
            <p
              class="text-xs font-label uppercase text-on-surface-variant font-bold tracking-widest"
            >
              Telefon
            </p>
            <a
              href="tel:031556508"
              class="text-xl font-headline font-bold text-primary hover:text-primary/80 transition-colors"
              >031-556-508</a
            >
          </div>
        </div>

        <div class="flex items-center gap-6">
          <div
            class="w-12 h-12 bg-surface-container-high rounded-full flex items-center justify-center text-primary flex-shrink-0"
            aria-hidden="true"
          >
            <span class="material-symbols-outlined" aria-hidden="true">mail</span>
          </div>
          <div>
            <p
              class="text-xs font-label uppercase text-on-surface-variant font-bold tracking-widest"
            >
              E-pošta
            </p>
            <a
              href="mailto:info@alesjelnikar.si"
              class="text-xl font-headline font-bold text-primary hover:text-primary/80 transition-colors"
              >info@alesjelnikar.si</a
            >
          </div>
        </div>

        <div class="flex items-center gap-6">
          <div
            class="w-12 h-12 bg-surface-container-high rounded-full flex items-center justify-center text-primary flex-shrink-0"
            aria-hidden="true"
          >
            <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
          </div>
          <div>
            <p
              class="text-xs font-label uppercase text-on-surface-variant font-bold tracking-widest"
            >
              Področje
            </p>
            <p class="text-xl font-headline font-bold text-primary">
              Slovenija
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Contact form -->
    <div
      class="bg-surface-container-low p-8 md:p-12 rounded-2xl shadow-[0_20px_40px_rgba(43,44,42,0.06)]"
    >
      <form id="contact-form" class="space-y-6">
        <div class="space-y-2">
          <label
            for="ime"
            class="font-label text-xs font-bold text-on-surface-variant uppercase tracking-widest"
            >Ime in Priimek <span aria-label="obvezno">*</span></label
          >
          <input
            id="ime"
            name="ime"
            type="text"
            required
            maxlength="100"
            placeholder="Vaše ime"
            class="w-full bg-surface px-4 py-3 rounded-lg border border-outline-variant/40 focus:outline-none focus:ring-2 focus:ring-primary text-on-surface placeholder:text-on-surface-variant/50"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label
              for="email"
              class="font-label text-xs font-bold text-on-surface-variant uppercase tracking-widest"
              >E-naslov <span aria-label="obvezno">*</span></label
            >
            <input
              id="email"
              name="email"
              type="email"
              required
              maxlength="200"
              placeholder="vas@email.si"
              class="w-full bg-surface px-4 py-3 rounded-lg border border-outline-variant/40 focus:outline-none focus:ring-2 focus:ring-primary text-on-surface placeholder:text-on-surface-variant/50"
            />
          </div>
          <div class="space-y-2">
            <label
              for="telefon"
              class="font-label text-xs font-bold text-on-surface-variant uppercase tracking-widest"
              >Telefon</label
            >
            <input
              id="telefon"
              name="telefon"
              type="tel"
              maxlength="20"
              placeholder="+386 41 ..."
              class="w-full bg-surface px-4 py-3 rounded-lg border border-outline-variant/40 focus:outline-none focus:ring-2 focus:ring-primary text-on-surface placeholder:text-on-surface-variant/50"
            />
          </div>
        </div>

        <div class="space-y-2">
          <label
            for="datum"
            class="font-label text-xs font-bold text-on-surface-variant uppercase tracking-widest"
            >Željeni datum ogleda</label
          >
          <input
            id="datum"
            name="datum"
            type="date"
            class="w-full bg-surface px-4 py-3 rounded-lg border border-outline-variant/40 focus:outline-none focus:ring-2 focus:ring-primary text-on-surface"
          />
        </div>

        <div class="space-y-2">
          <label
            for="opis"
            class="font-label text-xs font-bold text-on-surface-variant uppercase tracking-widest"
            >Sporočilo <span aria-label="obvezno">*</span></label
          >
          <textarea
            id="opis"
            name="opis"
            required
            rows="5"
            maxlength="2000"
            placeholder="Opišite vašo potrebo ali povpraševanje..."
            class="w-full bg-surface px-4 py-3 rounded-lg border border-outline-variant/40 focus:outline-none focus:ring-2 focus:ring-primary text-on-surface placeholder:text-on-surface-variant/50 resize-none"
          ></textarea>
        </div>

        <!-- Honeypot — hidden from real users, catches bots -->
        <input
          type="text"
          name="website"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="hidden"
        />

        <!-- Status message -->
        <div
          id="form-status"
          role="alert"
          aria-live="polite"
          class="hidden text-sm font-body px-4 py-3 rounded-lg"
        ></div>

        <button
          type="submit"
          id="submit-btn"
          class="w-full bg-primary text-on-primary font-label font-bold py-4 rounded-lg hover:bg-primary/90 transition-all shadow-lg active:scale-95 duration-150"
        >
          Pošljite sporočilo
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const statusEl = document.getElementById("form-status") as HTMLDivElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = "Pošiljanje...";

    const data = Object.fromEntries(new FormData(form));

    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 10000);

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
        signal: controller.signal,
      });
      clearTimeout(timeout);
      const json = await res.json();

      statusEl.classList.remove(
        "hidden",
        "bg-error-container",
        "text-on-error-container",
        "bg-primary-fixed",
        "text-on-primary-fixed",
      );

      if (res.ok) {
        statusEl.classList.add("bg-primary-fixed", "text-on-primary-fixed");
        statusEl.textContent =
          json.message ?? "Sporočilo je bilo uspešno poslano!";
        form.reset();
      } else {
        statusEl.classList.add("bg-error-container", "text-on-error-container");
        statusEl.textContent =
          json.message ?? "Prišlo je do napake. Prosimo, poskusite znova.";
      }
    } catch (err) {
      clearTimeout(timeout);
      statusEl.classList.remove("hidden", "bg-error-container");
      statusEl.classList.add("bg-error-container", "text-on-error-container");
      statusEl.textContent =
        err instanceof Error && err.name === "AbortError"
          ? "Zahtevek je trajal predolgo. Prosimo, poskusite znova."
          : "Napaka pri pošiljanju. Preverite internetno povezavo.";
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Pošljite sporočilo";
      statusEl.classList.remove("hidden");
      statusEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }
  });
</script>

---
---

<section id="o-nas" class="py-24 md:py-32 px-6 md:px-24 bg-primary text-on-primary">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-20 items-center">
    <div class="relative">
      <div class="aspect-square bg-surface-container-highest/10 rounded-full absolute -top-10 -left-10 w-64 h-64 blur-3xl"></div>
      <img
        alt="Aleš Jelnikar, certificiran VELUX monter"
        class="rounded-2xl shadow-2xl relative z-10 w-full h-[500px] md:h-[600px] object-cover border-4 border-secondary/30"
        src="/ales.jpg"
        loading="lazy"
        width="600"
        height="600"
      />
      <div class="absolute -bottom-8 -right-4 md:-right-8 bg-secondary text-on-secondary p-6 md:p-8 rounded-xl shadow-2xl z-20">
        <p class="font-headline font-black text-3xl md:text-4xl">15+</p>
        <p class="font-label text-xs uppercase tracking-widest opacity-90">Let izkušenj</p>
      </div>
    </div>

    <div class="space-y-8 mt-8 md:mt-0">
      <span class="font-label text-secondary font-bold uppercase tracking-widest text-sm">O nas</span>
      <h2 class="font-headline text-4xl md:text-5xl font-bold leading-tight">
        Mojstrstvo in zaupanje z Alešem Jelnikarjem
      </h2>
      <p class="font-body text-lg opacity-80 leading-relaxed">
        Sem Aleš Jelnikar, certificiran montažer VELUX izdelkov. Moja vizija je preprosta: v vsak dom prinesti več naravne svetlobe in svežega zraka na način, ki zagotavlja varnost, energetsko učinkovitost in brezskrbnost za naročnika.
      </p>
      <ul class="space-y-4">
        <li class="flex items-center gap-4">
          <span class="material-symbols-outlined text-secondary flex-shrink-0">verified</span>
          <span class="font-body">Certificiran VELUX strokovnjak</span>
        </li>
        <li class="flex items-center gap-4">
          <span class="material-symbols-outlined text-secondary flex-shrink-0">task_alt</span>
          <span class="font-body">Uporaba originalnih VELUX materialov</span>
        </li>
        <li class="flex items-center gap-4">
          <span class="material-symbols-outlined text-secondary flex-shrink-0">handshake</span>
          <span class="font-body">Osebni pristop in brezplačno svetovanje</span>
        </li>
        <li class="flex items-center gap-4">
          <span class="material-symbols-outlined text-secondary flex-shrink-0">map</span>
          <span class="font-body">Pokrivamo celotno Slovenijo</span>
        </li>
      </ul>
    </div>
  </div>
</section>

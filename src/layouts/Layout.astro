---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Aleš Jelnikar – Vgradnja VELUX strešnih oken",
  description = "Certificiran montažer VELUX strešnih oken. Profesionalna vgradnja, servis in vzdrževanje po celotni Sloveniji.",
  ogImage = "/og-image.jpg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="sl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="sl" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content="sl_SI" />
    <meta property="og:site_name" content="Aleš Jelnikar – VELUX" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
      rel="stylesheet"
    />

    <!-- LocalBusiness JSON-LD -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Aleš Jelnikar – VELUX strešna okna",
        "description": "Certificiran montažer VELUX strešnih oken. Profesionalna vgradnja, servis in vzdrževanje.",
        "url": "https://alesjelnikar.si",
        "telephone": "031556508",
        "email": "info@alesjelnikar.si",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Slovenija",
          "addressCountry": "SI"
        },
        "areaServed": "Slovenija",
        "priceRange": "$$"
      }
    </script>
  </head>
  <body class="bg-background text-on-background font-body antialiased">
    <!-- Skip link for keyboard users -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-primary focus:text-on-primary focus:px-4 focus:py-2 focus:rounded-lg focus:font-label focus:font-bold focus:text-sm"
    >
      Preskoči na vsebino
    </a>

    <!-- Navigation -->
    <header
      id="nav"
      class="fixed top-0 w-full z-50 bg-[#fcf9f5]/80 backdrop-blur-md shadow-[0_20px_40px_rgba(43,44,42,0.06)] transition-all duration-300"
    >
      <div
        class="max-w-7xl mx-auto flex justify-between items-center px-6 md:px-8 py-5"
      >
        <a href="/" class="flex items-center gap-3">
          <span
            class="font-headline font-black text-primary uppercase tracking-widest text-lg leading-none"
          >
            Aleš Jelnikar
          </span>
        </a>

        <nav class="hidden md:flex items-center gap-8">
          <a
            href="#storitve"
            class="font-label text-sm font-semibold text-on-surface-variant hover:text-primary transition-colors"
            >Storitve</a
          >
          <a
            href="#galerija"
            class="font-label text-sm font-semibold text-on-surface-variant hover:text-primary transition-colors"
            >Galerija</a
          >
          <a
            href="#o-nas"
            class="font-label text-sm font-semibold text-on-surface-variant hover:text-primary transition-colors"
            >O nas</a
          >
          <a
            href="#ocene"
            class="font-label text-sm font-semibold text-on-surface-variant hover:text-primary transition-colors"
            >Ocene</a
          >
          <a
            href="#kontakt"
            class="font-label text-sm font-semibold text-on-surface-variant hover:text-primary transition-colors"
            >Kontakt</a
          >
        </nav>

        <a
          href="#kontakt"
          class="hidden md:inline-flex bg-primary text-on-primary font-label text-sm font-bold px-5 py-2.5 rounded-lg hover:bg-primary/90 transition-colors active:scale-95 duration-150"
        >
          Brezplačen ogled
        </a>

        <!-- Mobile menu button -->
        <button
          id="menu-btn"
          class="md:hidden text-primary"
          aria-label="Odpri meni"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <span class="material-symbols-outlined text-2xl" aria-hidden="true">menu</span>
        </button>
      </div>

      <!-- Mobile nav -->
      <div
        id="mobile-nav"
        class="hidden md:hidden bg-background border-t border-outline-variant/20 px-6 py-4"
      >
        <nav class="flex flex-col gap-4">
          <a
            href="#storitve"
            class="font-label font-semibold text-on-surface-variant py-2"
            >Storitve</a
          >
          <a
            href="#galerija"
            class="font-label font-semibold text-on-surface-variant py-2"
            >Galerija</a
          >
          <a
            href="#o-nas"
            class="font-label font-semibold text-on-surface-variant py-2"
            >O nas</a
          >
          <a
            href="#ocene"
            class="font-label font-semibold text-on-surface-variant py-2"
            >Ocene</a
          >
          <a
            href="#kontakt"
            class="font-label font-semibold text-on-surface-variant py-2"
            >Kontakt</a
          >
          <a
            href="#kontakt"
            class="bg-primary text-on-primary font-label font-bold px-5 py-3 rounded-lg text-center mt-2"
          >
            Brezplačen ogled
          </a>
        </nav>
      </div>
    </header>

    <main id="main-content" class="pt-20">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-primary text-on-primary px-8 md:px-12 py-16">
      <div
        class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start md:items-center gap-10"
      >
        <div class="space-y-3">
          <p
            class="font-headline font-black text-secondary text-xl uppercase tracking-widest"
          >
            Aleš Jelnikar
          </p>
          <p class="font-body text-on-primary/70 text-sm max-w-xs">
            Certificiran monter VELUX strešnih oken z več kot 15 leti izkušenj.
          </p>
        </div>
        <nav class="flex flex-wrap gap-6">
          <a
            href="#storitve"
            class="font-body text-on-primary/70 text-sm hover:text-on-primary transition-colors"
            >Storitve</a
          >
          <a
            href="#galerija"
            class="font-body text-on-primary/70 text-sm hover:text-on-primary transition-colors"
            >Galerija</a
          >
          <a
            href="#ocene"
            class="font-body text-on-primary/70 text-sm hover:text-on-primary transition-colors"
            >Ocene</a
          >
          <a
            href="#kontakt"
            class="font-body text-on-primary/70 text-sm hover:text-on-primary transition-colors"
            >Kontakt</a
          >
        </nav>
        <p class="font-body text-on-primary/50 text-sm">
          © {new Date().getFullYear()} Aleš Jelnikar. Vse pravice pridržane.
        </p>
      </div>
    </footer>

    <script>
      // Mobile menu toggle
      const btn = document.getElementById("menu-btn") as HTMLButtonElement;
      const nav = document.getElementById("mobile-nav");
      btn?.addEventListener("click", () => {
        const isOpen = nav?.classList.toggle("hidden") === false;
        btn.setAttribute("aria-expanded", String(isOpen));
        btn.setAttribute("aria-label", isOpen ? "Zapri meni" : "Odpri meni");
      });
      // Close mobile nav when a link is clicked
      nav?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          nav.classList.add("hidden");
          btn?.setAttribute("aria-expanded", "false");
          btn?.setAttribute("aria-label", "Odpri meni");
        });
      });
    </script>
  </body>
</html>

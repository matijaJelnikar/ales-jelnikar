---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Aleš Jelnikar – Servis VELUX strešnih oken",
  description = "Priporočen VELUX izvajalec. Profesionalen servis, vgradnja in vzdrževanje strešnih oken po celotni Sloveniji.",
  ogImage = "/og-image.jpg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="sl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->
    <link rel="icon" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="sl" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content="sl_SI" />
    <meta property="og:site_name" content="Aleš Jelnikar – VELUX" />

    <!-- Google Fonts — non-blocking load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap"
        rel="stylesheet"
      />
      <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
        rel="stylesheet"
      />
    </noscript>

    <!-- LocalBusiness JSON-LD -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Aleš Jelnikar – VELUX strešna okna",
        "description": "Priporočen VELUX izvajalec. Profesionalna vgradnja, servis in vzdrževanje strešnih oken.",
        "url": "https://alesjelnikar.si",
        "telephone": "031556508",
        "email": "info@alesjelnikar.si",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Slovenija",
          "addressCountry": "SI"
        },
        "areaServed": "Slovenija",
        "priceRange": "$$"
      }
    </script>
  </head>
  <body class="bg-background text-on-background font-body antialiased">
    <!-- Skip link for keyboard users -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-primary focus:text-on-primary focus:px-4 focus:py-2 focus:rounded-lg focus:font-label focus:font-bold focus:text-sm"
    >
      Preskoči na vsebino
    </a>

    <!-- Navigation -->
    <header
      id="nav"
      class="bg-white/80 backdrop-blur-md fixed top-0 w-full z-50"
    >
      <nav class="flex justify-between items-center px-6 py-4 max-w-7xl mx-auto">
        <a href="/" class="flex items-center gap-3">
          <span class="material-symbols-outlined text-red-600" aria-hidden="true">grid_view</span>
          <span class="font-headline font-black text-zinc-900 text-xl tracking-tighter uppercase">
            ALEŠ JELNIKAR
          </span>
        </a>

        <div class="hidden md:flex items-center gap-8">
          <a
            href="/#storitve"
            class="text-zinc-600 font-medium hover:text-primary transition-colors"
            >Storitve</a
          >
          <a
            href="/#galerija"
            class="text-zinc-600 font-medium hover:text-primary transition-colors"
            >Galerija</a
          >
          <a
            href="/#o-nas"
            class="text-zinc-600 font-medium hover:text-primary transition-colors"
            >O nas</a
          >
          <a
            href="/povprasevanje"
            class="text-zinc-600 font-medium hover:text-primary transition-colors"
            >Povpraševanje</a
          >
          <a
            href="/#kontakt"
            class="bg-primary text-on-primary px-6 py-2 font-bold hover:opacity-90 active:scale-95 duration-200 transition-all"
            >Kontakt</a
          >
        </div>

        <!-- Mobile menu button -->
        <button
          id="menu-btn"
          class="md:hidden text-on-surface"
          aria-label="Odpri meni"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <span class="material-symbols-outlined text-3xl" aria-hidden="true">menu</span>
        </button>
      </nav>

      <!-- Mobile nav -->
      <div
        id="mobile-nav"
        class="hidden md:hidden bg-white border-t border-outline-variant/20 px-6 py-4"
      >
        <nav class="flex flex-col gap-4">
          <a
            href="/#storitve"
            class="font-label font-semibold text-zinc-600 py-2"
            >Storitve</a
          >
          <a
            href="/#galerija"
            class="font-label font-semibold text-zinc-600 py-2"
            >Galerija</a
          >
          <a
            href="/#o-nas"
            class="font-label font-semibold text-zinc-600 py-2"
            >O nas</a
          >
          <a
            href="/povprasevanje"
            class="font-label font-semibold text-zinc-600 py-2"
            >Povpraševanje</a
          >
          <a
            href="/#kontakt"
            class="bg-primary text-on-primary font-label font-bold px-5 py-3 text-center mt-2"
          >
            Kontakt
          </a>
        </nav>
      </div>
    </header>

    <main id="main-content" class="pt-[72px]">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-zinc-100 w-full py-12 border-t border-zinc-200">
      <div
        class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center px-8 gap-8"
      >
        <div class="flex flex-col items-center md:items-start gap-2">
          <span class="font-headline font-extrabold text-zinc-900 text-xl tracking-tighter uppercase">ALEŠ JELNIKAR</span>
          <p class="font-body text-sm uppercase tracking-widest text-zinc-500">
            © {new Date().getFullYear()} Aleš Jelnikar. Vse pravice pridržane.
          </p>
        </div>
        <nav class="flex flex-wrap justify-center gap-6">
          <a
            href="/#storitve"
            class="font-body text-sm uppercase tracking-widest text-zinc-500 hover:text-primary underline-offset-4 hover:underline transition-all opacity-80 hover:opacity-100"
            >Storitve</a
          >
          <a
            href="/#galerija"
            class="font-body text-sm uppercase tracking-widest text-zinc-500 hover:text-primary underline-offset-4 hover:underline transition-all opacity-80 hover:opacity-100"
            >Galerija</a
          >
          <a
            href="/#o-nas"
            class="font-body text-sm uppercase tracking-widest text-zinc-500 hover:text-primary underline-offset-4 hover:underline transition-all opacity-80 hover:opacity-100"
            >O nas</a
          >
          <a
            href="/povprasevanje"
            class="font-body text-sm uppercase tracking-widest text-zinc-500 hover:text-primary underline-offset-4 hover:underline transition-all opacity-80 hover:opacity-100"
            >Povpraševanje</a
          >
          <a
            href="/#kontakt"
            class="font-body text-sm uppercase tracking-widest text-zinc-500 hover:text-primary underline-offset-4 hover:underline transition-all opacity-80 hover:opacity-100"
            >Kontakt</a
          >
        </nav>
      </div>
    </footer>

    <!-- Mobile FAB: tap to call -->
    <a
      href="tel:031556508"
      class="fixed bottom-6 right-6 bg-primary text-on-primary w-14 h-14 rounded-full shadow-2xl flex items-center justify-center md:hidden z-[100] active:scale-90 transition-transform"
      aria-label="Pokličite nas"
    >
      <span class="material-symbols-outlined text-3xl" aria-hidden="true">call</span>
    </a>

    <script>
      // Mobile menu toggle
      const btn = document.getElementById("menu-btn") as HTMLButtonElement;
      const nav = document.getElementById("mobile-nav");
      btn?.addEventListener("click", () => {
        const isOpen = nav?.classList.toggle("hidden") === false;
        btn.setAttribute("aria-expanded", String(isOpen));
        btn.setAttribute("aria-label", isOpen ? "Zapri meni" : "Odpri meni");
      });
      // Close mobile nav when a link is clicked
      nav?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          nav.classList.add("hidden");
          btn?.setAttribute("aria-expanded", "false");
          btn?.setAttribute("aria-label", "Odpri meni");
        });
      });
    </script>
  </body>
</html>
